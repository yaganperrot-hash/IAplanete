# Base de données SQLite (fichier local, pas besoin de Docker)
DATABASE_FILE=./data/aiplanet.db

# Server
PORT=4000
NODE_ENV=development

# Simulation
# 5 espèces 24h/24 gratuit = 300000 (5 min) | Tests rapides = 15000 (15s)
TICK_INTERVAL_MS=300000
TICKS_PER_DAY=10

# Population (configurable sans redémarrage de la DB)
MAX_POP_PER_SPECIES=300
SPAWN_COUNT=80

# LLM Gemini (optionnel — laissez vide pour utiliser le mock LLM intégré)
# Obtenir une clé gratuite : https://aistudio.google.com/apikey
# GEMINI_API_KEY=votre_cle_api_ici
